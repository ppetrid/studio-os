# Template: deploy/install.sh fills in the @...@ placeholders and installs it
# as /etc/systemd/system/studio-os.service. Edit this file, not the installed copy.

[Unit]
Description=Studio OS MIDI router
After=network.target sound.target

[Service]
# Needs to be in the audio group to open /dev/snd/seq.
User=@USER@
# devices.json and presets.json are read relative to this directory.
WorkingDirectory=@APP_DIR@
# Keep a single worker: each one would open its own ALSA sequencer client.
ExecStart=@APP_DIR@/.venv/bin/uvicorn api.app:app --host 0.0.0.0 --port @PORT@
# A port below 1024 (e.g. 80) also needs:
# AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
